###############################################################################
#                         🍾 BOTTLE GAME API                                   #
#                         HTTP Request Collection                              #
###############################################################################

# ============================================================================
# ПЕРЕМЕННЫЕ
# ============================================================================
@baseUrl = https://localhost:7001/api
@processingBaseUrl = https://app.payshark.net
@contentType = application/json

# Токены (заполнить после авторизации)
@adminToken = YOUR_ADMIN_JWT_TOKEN_HERE
@moderatorToken = YOUR_MODERATOR_JWT_TOKEN_HERE
@playerToken = YOUR_PLAYER_JWT_TOKEN_HERE

# ID для тестирования
@playerId = 1
@moderatorId = 1
@transactionId = 1


###############################################################################
#                            🔐 АУТЕНТИФИКАЦИЯ                                 #
###############################################################################

### 🔑 Авторизация администратора
# @name adminLogin
POST {{baseUrl}}/Auth/admin-login
Content-Type: {{contentType}}

{
    "login": "admin",
    "password": "your_password_here"
}

### 🎮 Авторизация игрока через Telegram
# @name playerLogin
# Для тестирования нужен валидный initData от Telegram
POST {{baseUrl}}/Auth/player-login/YOUR_TELEGRAM_INIT_DATA_HERE


###############################################################################
#                           👤 УПРАВЛЕНИЕ ИГРОКАМИ                             #
###############################################################################

### 📋 Получить всех игроков (Admin)
GET {{baseUrl}}/Player/get-all-players
Authorization: Bearer {{adminToken}}

### 🏆 Получить ТОП-100 игроков (Admin)
GET {{baseUrl}}/Player/get-top100-players
Authorization: Bearer {{adminToken}}

### 👁️ Получить данные игрока (Admin/Player)
GET {{baseUrl}}/Player/get-player/{{playerId}}
Authorization: Bearer {{adminToken}}

### ✏️ Редактировать игрока (Admin/Player)
POST {{baseUrl}}/Player/edit-player/{{playerId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "name": "Новое имя игрока",
    "avatarUrl": "https://example.com/avatar.jpg",
    "winChance": 0.5,
    "currency": 0,
    "paymentMethod": 0,
    "wallet": "79001234567",
    "payoutMethod": 0,
    "balance": 1000
}


###############################################################################
#                           🚫 УПРАВЛЕНИЕ БАНАМИ                               #
###############################################################################

### ❓ Проверить статус бана (Admin/Player)
GET {{baseUrl}}/Player/is-banned/{{playerId}}
Authorization: Bearer {{adminToken}}

### 🔨 Забанить игрока (Admin)
POST {{baseUrl}}/Player/ban-player
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "playerId": {{playerId}},
    "banReason": "Нарушение правил использования сервиса"
}

### 🔓 Разбанить игрока (Admin)
POST {{baseUrl}}/Player/unban-player/{{playerId}}
Authorization: Bearer {{adminToken}}


###############################################################################
#                            📊 СТАТИСТИКА ИГРОКОВ                             #
###############################################################################

### 📈 Получить статистику всех игроков (Admin)
GET {{baseUrl}}/Player/get-all-players-statistics
Authorization: Bearer {{adminToken}}

### 📊 Получить статистику игрока (Admin)
GET {{baseUrl}}/Player/get-player-statistics/{{playerId}}
Authorization: Bearer {{adminToken}}

### 🎰 Получить статистику раундов для вывода (Admin/Player)
GET {{baseUrl}}/Player/get-player-rounds-statistics-for-withdrawal/{{playerId}}
Authorization: Bearer {{adminToken}}

### 📝 Получить статистику раундов для вывода по всем игрокам (Admin/Moderator)
GET {{baseUrl}}/Player/get-all-players-rounds-statistics-for-withdrawal
Authorization: Bearer {{adminToken}}


###############################################################################
#                           💰 БАЛАНС И ТРАНЗАКЦИИ                             #
###############################################################################

### 💵 Получить баланс игрока (Admin/Player)
GET {{baseUrl}}/Balance/get-player-balance/{{playerId}}
Authorization: Bearer {{adminToken}}

### 💳 Создать транзакцию - ДЕПОЗИТ (Admin/Player)
POST {{baseUrl}}/Balance/create-transaction/{{playerId}}
Authorization: Bearer {{playerToken}}
Content-Type: {{contentType}}

{
    "amount": 1000,
    "isDeposit": true
}

### 💸 Создать транзакцию - ВЫВОД (Admin/Player)
POST {{baseUrl}}/Balance/create-transaction/{{playerId}}
Authorization: Bearer {{playerToken}}
Content-Type: {{contentType}}

{
    "amount": 500,
    "isDeposit": false
}

### ✅ Одобрить транзакцию (Admin/Moderator)
# StatusId: 2 = Approved, 3 = Rejected
POST {{baseUrl}}/Balance/update-transaction-status/{{transactionId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "transactionStatusId": 2
}

### ❌ Отклонить транзакцию (Admin/Moderator)
POST {{baseUrl}}/Balance/update-transaction-status/{{transactionId}}
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "transactionStatusId": 3
}

### 📜 Получить транзакции игрока (Admin/Player)
GET {{baseUrl}}/Balance/get-player-transactions/{{playerId}}
Authorization: Bearer {{adminToken}}

### 📋 Получить все транзакции (Admin)
GET {{baseUrl}}/Balance/get-all-transactions
Authorization: Bearer {{adminToken}}

### 📋 Получить все транзакции по типу (Admin)
# typeId: 1 = Deposit, 2 = Withdrawal
GET {{baseUrl}}/Balance/get-all-transactions?typeId=1
Authorization: Bearer {{adminToken}}

### 🏷️ Получить все статусы транзакций (Admin)
GET {{baseUrl}}/Balance/get-all-transaction-statuses
Authorization: Bearer {{adminToken}}

### 📌 Получить все типы транзакций (Admin)
GET {{baseUrl}}/Balance/get-all-transaction-types
Authorization: Bearer {{adminToken}}


###############################################################################
#                           🎰 ИГРОВЫЕ РАУНДЫ                                  #
###############################################################################

### 🎮 Завершить раунд - ПОБЕДА (Admin/Player)
POST {{baseUrl}}/GameRound/finish-game-round/{{playerId}}
Authorization: Bearer {{playerToken}}
Content-Type: {{contentType}}

{
    "bet": 100,
    "isWin": true
}

### 💔 Завершить раунд - ПРОИГРЫШ (Admin/Player)
POST {{baseUrl}}/GameRound/finish-game-round/{{playerId}}
Authorization: Bearer {{playerToken}}
Content-Type: {{contentType}}

{
    "bet": 100,
    "isWin": false
}

### 📜 Получить сыгранные раунды игрока (Admin)
GET {{baseUrl}}/GameRound/get-player-played-rounds/{{playerId}}
Authorization: Bearer {{adminToken}}

### 💰 Получить прибыль за период (Admin)
GET {{baseUrl}}/GameRound/get-profit
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "dateFrom": "2024-01-01T00:00:00Z",
    "dateTill": "2025-12-31T23:59:59Z"
}


###############################################################################
#                           ⚙️ ИГРОВЫЕ ПАРАМЕТРЫ                               #
###############################################################################

### 🎛️ Получить игровые параметры (Admin/Player)
GET {{baseUrl}}/GameParams/get-game-params
Authorization: Bearer {{adminToken}}

### 🔧 Обновить игровые параметры (Admin)
POST {{baseUrl}}/GameParams/update-game-params
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "id": 1,
    "baseWinChance": 0.5,
    "minDepositAmount": 100,
    "minRoundsCountForWithdrawal": 5,
    "minWinChance": 0.1,
    "maxWinChance": 0.9,
    "chanceDecPerThrowMin": 0.05,
    "chanceDecPerThrowMax": 0.1,
    "chanceDecPerRotation": 0.05,
    "minRotationWinChance": 0.1,
    "minMultiplier": 1.5,
    "maxMultiplier": 2.0,
    "initialBalanceLoss": 0.1,
    "deviationChance": 0.5,
    "maxDeviationPercent": 0.5,
    "minGamesForBoost": 10,
    "winBoostChance": 0.1,
    "winBoostMultiplier": 2.0,
    "hardResetChance": 0.05,
    "controlGoal": 100,
    "reelSpeed": 1.0,
    "uprightThresholdForLine": 0.5
}

### 💳 Получить все методы выплат (Admin/Player)
GET {{baseUrl}}/GameParams/get-all-payout-methods
Authorization: Bearer {{adminToken}}

### 💵 Получить все методы пополнения (Admin/Player)
GET {{baseUrl}}/GameParams/get-all-payment-methods
Authorization: Bearer {{adminToken}}

### 💱 Получить все валюты (Admin/Player)
GET {{baseUrl}}/GameParams/get-all-currencies
Authorization: Bearer {{adminToken}}


###############################################################################
#                           🔗 РЕФЕРАЛЬНЫЕ ССЫЛКИ                              #
###############################################################################

### 🔗 Получить реферальную ссылку (Admin/Player)
GET {{baseUrl}}/Referral/get-referral-link/{{playerId}}
Authorization: Bearer {{adminToken}}


###############################################################################
#                         🛡️ АДМИНИСТРИРОВАНИЕ                                #
###############################################################################

### 💰 Получить баланс приложения (Admin)
GET {{baseUrl}}/Admin/get-app-balance
Authorization: Bearer {{adminToken}}

### 📉 Обновить порог баланса приложения (Admin)
POST {{baseUrl}}/Admin/update-threshold
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "lowerThreshold": 5000
}

### 💸 Пополнить баланс приложения (Admin)
POST {{baseUrl}}/Admin/topup-balance
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "amount": 10000
}

### 📊 Получить административную статистику (Admin)
GET {{baseUrl}}/Admin/get-statistics
Authorization: Bearer {{adminToken}}


###############################################################################
#                         👥 УПРАВЛЕНИЕ МОДЕРАТОРАМИ                           #
###############################################################################

### ➕ Зарегистрировать модератора (Admin)
POST {{baseUrl}}/Admin/moderator-register
Authorization: Bearer {{adminToken}}
Content-Type: {{contentType}}

{
    "login": "new_moderator",
    "password": "SecurePassword123"
}

### 📋 Получить всех модераторов (Admin)
GET {{baseUrl}}/Admin/get-moderators
Authorization: Bearer {{adminToken}}

### 👤 Получить модератора по ID (Admin)
GET {{baseUrl}}/Admin/get-moderators?moderatorId={{moderatorId}}
Authorization: Bearer {{adminToken}}

### 🗑️ Удалить модератора (Admin)
DELETE {{baseUrl}}/Admin/delete-moderator/{{moderatorId}}
Authorization: Bearer {{adminToken}}


###############################################################################
#                           💱 ВАЛЮТЫ И ШЛЮЗЫ                                  #
###############################################################################

### 💱 Получить все доступные валюты (Public)
GET {{processingBaseUrl}}/currencies

### 💱 Получить валюты с обновлением кэша (Public)
GET {{processingBaseUrl}}/currencies?forceRefresh=true

### 🏦 Получить все платёжные шлюзы (Public)
GET {{processingBaseUrl}}/currencies/gateways

### 💳 Получить шлюзы для приёма платежей в RUB (Public)
GET {{processingBaseUrl}}/currencies/rub/payment-gateways

### 💸 Получить шлюзы для выплат в RUB (Public)
GET {{processingBaseUrl}}/currencies/rub/payout-gateways

### 📈 Получить курс обмена для RUB (Public)
GET {{processingBaseUrl}}/currencies/rub/exchange-rate

### ✅ Проверить активность валюты (Public)
GET {{processingBaseUrl}}/currencies/rub/is-active

### 🔢 Проверить допустимость суммы для шлюза (Public)
GET {{processingBaseUrl}}/currencies/gateways/sberbank/validate-amount?amount=5000

### 🗑️ Очистить кэш справочников (Admin)
POST {{processingBaseUrl}}/currencies/cache/clear
Authorization: Bearer {{adminToken}}


###############################################################################
#                              📖 СПРАВОЧНИК                                   #
###############################################################################

# Роли:
#   - Admin: Полный доступ ко всем эндпоинтам
#   - Moderator: Управление транзакциями и статистикой
#   - Player: Игровые действия и личные данные

# Статусы транзакций:
#   - 1: Pending (В ожидании)
#   - 2: Approved (Одобрено)
#   - 3: Rejected (Отклонено)

# Типы транзакций:
#   - 1: Deposit (Пополнение)
#   - 2: Withdrawal (Вывод)

# Валюты (CurrencyType):
#   - 0: RUB (Рубли)
#   - 1: USD (Доллары)
#   - 2: EUR (Евро)

# Методы оплаты (PaymentMethodType):
#   - 0: sbp_rub (СБП в рублях)
#   - 1: bankcard_rub (Банковская карта в рублях)
#   - и другие...

# Методы выплат (PayoutMethodType):
#   - 0: sbp_rub (СБП в рублях)
#   - 1: bankcard_rub (Банковская карта в рублях)
#   - и другие...
