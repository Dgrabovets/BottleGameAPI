{
    "AllowedHosts": "*",
    "CORS": {
        "AllowedOrigins": [ "https://admin.adminbottle.ru", "https://luckybottlex.com", "https://localhost:3000" ]
    },
    "ConnectionStrings": {
        "PostgresConnection": "Host=HOST;Port=5432;Username=USER;Password=PASSWORD;Database=DBNAME"
    },
    "Serilog": {
        "MinimumLevel": "Information",
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7
                }
            }
        ]
    },
    "JWT": {
        "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
        "Issuer": "BottleAppAPI",
        "Audience": "BottleGame",
        "ExpireMinutes": 360
    },
    "TelegramBotToken": "YOUR_TELEGRAM_BOT_TOKEN",
    "AppName": "luckybottle_bot/bottle",
    "Security": {
        "PasswordHashSecretKey": "YOUR_PASSWORD_HASH_SECRET"
    },
    "Processing": {
        "BaseUrl": "https://app.payshark.net",
        "AccessToken": "YOUR_PAYSHARK_ACCESS_TOKEN",
        "MerchantId": "YOUR_MERCHANT_UUID",
        "CallbackUrl": "https://api.adminbottle.ru/api/webhook",
        "MaxWaitMs": 30000
    },
    "Kestrel": {
        "Endpoints": {
            "Https": {
                "Url": "https://0.0.0.0:6001",
                "Certificate": {
                    "Path": "/etc/letsencrypt/live/api.adminbottle.ru/fullchain.pem",
                    "KeyPath": "/etc/letsencrypt/live/api.adminbottle.ru/privkey.pem"
                }
            }
        }
    }
}
