{
    "AllowedHosts": "*",
    "App": {
        "Version": "0.8.0"
    },
    "CORS": {
        "AllowedOrigins": [ "https://admin.adminbottle.ru", "https://luckybottlex.com", "https://localhost:3000" ]
    },
    "ConnectionStrings": {
        "PostgresConnection": "ENV_ConnectionStrings__PostgresConnection"
    },
    "Serilog": {
        "MinimumLevel": "Information",
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7
                }
            }
        ]
    },
    "JWT": {
        "Key": "ENV_JWT__Key",
        "Issuer": "BottleAppAPI",
        "Audience": "BottleGame",
        "ExpireMinutes": 360
    },
    "TelegramBotToken": "ENV_TelegramBotToken",
    "AppName": "luckybottle_bot/bottle",
    "Security": {
        "PasswordHashSecretKey": "ENV_Security__PasswordHashSecretKey"
    },
    "Processing": {
        "BaseUrl": "https://app.payshark.net",
        "AccessToken": "ENV_Processing__AccessToken",
        "MerchantId": "ENV_Processing__MerchantId",
        "CallbackUrl": "https://api.adminbottle.ru/api/webhook",
        "MaxWaitMs": 30000
    },
    "Kestrel": {
        "Endpoints": {
            "Https": {
                "Url": "https://0.0.0.0:6001",
                "Certificate": {
                    "Path": "/etc/letsencrypt/live/api.adminbottle.ru/fullchain.pem",
                    "KeyPath": "/etc/letsencrypt/live/api.adminbottle.ru/privkey.pem"
                }
            }
        }
    }
}
