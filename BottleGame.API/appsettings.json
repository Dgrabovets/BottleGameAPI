{
    "AllowedHosts": "*",
    "CORS": {
        "AllowedOrigins": [
            "http://localhost:3000"
        ]
    },
    "ConnectionStrings": {
        "PostgresConnection": "ENV_ConnectionStrings__PostgresConnection"
    },
    "Serilog": {
        "MinimumLevel": "Information",
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7
                }
            }
        ]
    },
    "JWT": {
        "Key": "ENV_JWT__Key",
        "Issuer": "BottleAppAPI",
        "Audience": "BottleGame",
        "ExpireMinutes": 360
    },
    "TelegramBotToken": "ENV_TelegramBotToken",
    "AppName": "your_bot/your_app",
    "Security": {
        "PasswordHashSecretKey": "ENV_Security__PasswordHashSecretKey"
    },
    "Processing": {
        "Mode": "Simulated",
        "BaseUrl": "https://api.yookassa.ru/v3/",
        "ShopId": "",
        "SecretKey": "",
        "PayoutAgentId": "",
        "PayoutSecretKey": "",
        "ReturnUrl": "",
        "TimeoutSeconds": 30,
        "PayoutRepeatWindowHours": 24
    }
}
