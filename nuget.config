<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Restore only from nuget.org so a missing offline source or fallback folder in a machine-wide
       NuGet.Config (for example a Visual Studio shared packages folder) cannot break the build. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
